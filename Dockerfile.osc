FROM golang:1.24.8-alpine as build

ARG TARGETARCH
ARG RELEASE=RELEASE.2025-10-15T17-29-55Z
ARG MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a

ENV GOPATH /go
ENV CGO_ENABLED 0

# Install curl and git
RUN apk add -U --no-cache ca-certificates && \
    apk add -U --no-cache curl git

# The upstream binary download host returns 410 Gone, so build from source
# at the commit of tag ${RELEASE}. A .git directory is required because
# buildscripts/gen-ldflags.go derives commit id and version from git log.
WORKDIR /src
RUN git init -q . && \
    git fetch -q --depth=1 https://github.com/eyevinn-osaas/minio.git ${MINIO_COMMIT} && \
    git checkout -q FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = "${MINIO_COMMIT}"

RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -tags kqueue -trimpath \
      --ldflags "$(MINIO_RELEASE=RELEASE go run buildscripts/gen-ldflags.go)" -o /go/bin/minio

RUN if [ "$TARGETARCH" = "amd64" ]; then \
       curl -L -s -q https://github.com/moparisthebest/static-curl/releases/latest/download/curl-${TARGETARCH} -o /go/bin/curl; \
       chmod +x /go/bin/curl; \
    fi

FROM registry.access.redhat.com/ubi9/ubi:latest

ARG RELEASE

# Install nginx
RUN dnf install -y nginx && \
    dnf clean all

LABEL name="MinIO" \
      vendor="MinIO Inc <dev@min.io>" \
      maintainer="MinIO Inc <dev@min.io>" \
      version="${RELEASE}" \
      release="${RELEASE}" \
      summary="MinIO is a High Performance Object Storage, API compatible with Amazon S3 cloud storage service." \
      description="MinIO object storage is fundamentally different. Designed for performance and the S3 API, it is 100% open-source. MinIO is ideal for large, private cloud environments with stringent security requirements and delivers mission-critical availability across a diverse range of workloads."

ENV MINIO_ACCESS_KEY_FILE=access_key \
    MINIO_SECRET_KEY_FILE=secret_key \
    MINIO_ROOT_USER_FILE=access_key \
    MINIO_ROOT_PASSWORD_FILE=secret_key \
    MINIO_KMS_SECRET_KEY_FILE=kms_master_key \
    MINIO_UPDATE_MINISIGN_PUBKEY="RWTx5Zr1tiHQLwG9keckT0c45M3AGeHD6IvimQHpyRywVWGbP1aVSGav" \
    MINIO_CONFIG_ENV_FILE=config.env \
    MC_CONFIG_DIR=/tmp/.mc \
    PORT=8080

COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /go/bin/minio /usr/bin/minio
COPY --from=build /go/bin/cur* /usr/bin/

COPY CREDITS /licenses/CREDITS
COPY LICENSE /licenses/LICENSE
COPY dockerscripts/docker-entrypoint-osc.sh /usr/bin/docker-entrypoint.sh
COPY nginx.conf.template /etc/nginx/nginx.conf.template

# Make entrypoint script executable
RUN chmod +x /usr/bin/docker-entrypoint.sh

EXPOSE $PORT
VOLUME ["/data"]

ENTRYPOINT ["/usr/bin/docker-entrypoint.sh"]
CMD ["minio", "server", "--address", "0.0.0.0:9000", "--console-address", "0.0.0.0:9001", "/data"]
